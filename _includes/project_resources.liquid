{% assign show_project_pdf = page.project_pdf %}
{% for publication in page.project_publications %}
  {% for resource in publication.links %}
    {% if resource.url == page.project_pdf %}{% assign show_project_pdf = false %}{% endif %}
  {% endfor %}
{% endfor %}
{% if page.github or show_project_pdf or page.demo_video or page.download_link or page.project_resources %}
  <section class="project-resources" aria-labelledby="project-resource-title">
    <h2 id="project-resource-title" class="project-resource-title">Project Resources</h2>
    {% if page.github or show_project_pdf or page.demo_video or page.download_link %}
      <div class="project-resource-links" aria-label="Project resources">
        {% if page.github %}
          <a
            {% if page.github contains '://' %}
              href="{{ page.github }}"
            {% else %}
              href="{{ page.github | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            title="Code Repository"
            aria-label="Code Repository"
          >
            <i class="fa-brands fa-github gh-icon"></i>
          </a>
        {% endif %}

        {% if show_project_pdf %}
          <a
            {% if page.project_pdf contains '://' %}
              href="{{ page.project_pdf }}"
            {% else %}
              href="{{ page.project_pdf | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            title="PDF Document"
            aria-label="PDF Document"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}

        {% if page.demo_video %}
          <a
            {% if page.demo_video contains '://' %}
              href="{{ page.demo_video }}"
            {% else %}
              href="{{ page.demo_video | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            title="Demo Video"
            aria-label="Demo Video"
          >
            <i class="fa-solid fa-video"></i>
          </a>
        {% endif %}

        {% if page.download_link %}
          <a
            {% if page.download_link contains '://' %}
              href="{{ page.download_link }}"
            {% else %}
              href="{{ page.download_link | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            title="Download Executable"
            aria-label="Download Executable"
          >
            <i class="fa-solid fa-download"></i>
          </a>
        {% endif %}
      </div>
    {% endif %}
    {% if page.project_resources %}
      <ul class="project-sidebar-list project-additional-resources">
        {% for resource in page.project_resources %}
          <li>
            {% include project_resource_link.liquid resource=resource %}
            {% if resource.credit -%}
              <span class="project-resource-credit">{{ resource.credit | escape }}</span>
            {%- endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </section>
{% endif %}
