<div class="col">
    <div class="card h-100 hoverable position-relative d-flex flex-column">
        
        <!-- Count the elements in the images array -->
        {% assign img_count = project.images | size %}

        {% if img_count > 1 %}
          <!-- Render carousel directly if multiple images exist -->
          {% include carousel.liquid images=project.images id=forloop.index %}
        {% elsif project.img %}
          <!-- Legacy fallback for a single image -->
          {%
            include figure.liquid
            loading="eager"
            path=project.img
            sizes="250px"
            alt="project thumbnail"
            class="card-img-top"
          %}
        {% endif %}
      
      <!-- Main Card Clickable Link Area -->
        <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" class="text-decoration-none text-dark d-flex flex-column flex-grow-1">
        <div class="card-body d-flex flex-column flex-grow-1">
          <h2 class="card-title mb-1">{{ project.title }}</h2>
          <p class="card-text">{{ project.description }}</p>
        </div>
        </a>

    <!-- Structured Card Footer (Both Icons and Date Locked to Bottom) -->
    <div class="card-footer bg-transparent border-top-0 pt-0 pb-3 mt-auto" style="position: relative; z-index: 2;">
      <!-- Single horizontal flex container -->
      <div class="d-flex align-items-center flex-wrap">
        
        {% if project.github %}

          <div class="github-icon d-flex align-items-center mr-1">
            <div class="icon" data-toggle="tooltip" title="Code Repository">
              <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
            </div>
            {% if project.github_stars %}
              <span class="stars ml-2" data-toggle="tooltip" title="GitHub Stars">
                <i class="fa-solid fa-star"></i>
                <span id="{{ project.github_stars }}-stars"></span>
              </span>
            {% endif %}
          </div>
        {% endif %}
        
        {% if project.project_pdf %}
          <div class="pdf-icon mr-1">
            <div class="icon" data-toggle="tooltip" title="PDF Document">
              <a href="{{ project.project_pdf }}"><i class="fa-solid fa-file-pdf pdf-icon"></i></a>
            </div>
          </div>
        {% endif %}
        
        {% if project.demo_video %}
          <div class="video-icon mr-1">
            <div class="icon" data-toggle="tooltip" title="Demo Video">
              <a href="{{ project.demo_video }}"><i class="fa-solid fa-video"></i></a>
            </div>
          </div>
        {% endif %}
        
        {% if project.download_link %}
          <div class="download-icon mr-1">
            <div class="icon" data-toggle="tooltip" title="Download Executable">
              <a href="{{ project.download_link }}"><i class="fa-solid fa-download"></i></a>
            </div>
          </div>
        {% endif %}

        <!-- Right Side: Completion Date (ml-auto pulls it to the far right side of the footer) -->
        {% if project.completed_on %}
          <p class="project-completed text-muted small ml-auto mb-0 align-self-center">Completed: {{ project.completed_on }}</p>
        {% endif %}

      </div>
    </div>
  </div>
</div>
