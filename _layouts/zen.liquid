---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    <!-- Category Filter Controls -->
    <div class="container text-center my-4">
      <div class="btn-group btn-group-toggle" data-toggle="buttons">
        <label class="btn btn-outline-secondary active btn-sm" onclick="filterPlants('all')">
          <input type="radio" name="options" checked> All Species
        </label>
        <label class="btn btn-outline-secondary btn-sm" onclick="filterPlants('Trees')">
          <input type="radio" name="options"> Trees
        </label>
        <label class="btn btn-outline-secondary btn-sm" onclick="filterPlants('Shrubs & Woody Vines')">
          <input type="radio" name="options"> Shrubs & Vines
        </label>
        <label class="btn btn-outline-secondary btn-sm" onclick="filterPlants('Herbaceous Plants & Wildflowers')">
          <input type="radio" name="options"> Herbaceous & Wildflowers
        </label>
        <label class="btn btn-outline-secondary btn-sm" onclick="filterPlants('Fungi & Marine Organisms')">
          <input type="radio" name="options"> Fungi & Marine
        </label>
      </div>
    </div>

    <!-- Hidden Server-Rendered Liquid Pool -->
    <div id="raw-plant-pool" style="display: none;">
      {% for plant in site.data.plants %}
        <!-- CRITICAL FIX: Give each card a permanent, static unique ID via forloop.index -->
        <div class="col-6 col-md-4 col-lg-3 text-center mb-4 plant-wrapper-group" 
             data-time="{{ plant.time }}" 
             data-category="{{ plant.category }}"
             data-id="{{ forloop.index }}">
          
          <!-- Card Component Layout -->
          <div class="plant-card" style="cursor: pointer;" data-toggle="modal" data-target="#plantModal-{{ forloop.index }}">
            <div class="plant-mount-container" style="background-image: url('{{ '/assets/img/plants/frame.png' | relative_url }}');">
              <div class="plant-circle-frame">
                <img src="{{ plant.image | relative_url }}" alt="{{ plant.name }}" class="plant-img img-fluid">
                <div class="plant-hover-overlay">
                  <span class="hover-text">🔎 View</span>
                </div>
              </div>
            </div>
            <p class="title">{{ plant.name }}</p>
          </div>

          <!-- Modal Window Overlay Layout -->
          <!-- CRITICAL FIX: Modal gets a permanent ID matching its trigger card -->
          <div class="modal fade plant-modal-element" id="plantModal-{{ forloop.index }}" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
              <div class="modal-content bg-card-color text-base-color border-0 shadow position-relative">
                <!-- CRITICAL FIX: Changed data-toggle to a custom handler class instead of data-target -->
                <button type="button" class="nav-arrow prev-arrow custom-nav-btn" data-dismiss="modal">‹</button>
                <button type="button" class="nav-arrow next-arrow custom-nav-btn" data-dismiss="modal">›</button>
                
                <div class="modal-header border-0 pb-0 justify-content-end">
                  <button type="button" class="close text-base-color" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                  </button>
                </div>
                <div class="modal-body text-center pt-0 px-5">
                  <img src="{{ plant.image | relative_url }}" alt="{{ plant.name }}" class="img-fluid rounded mb-3 max-modal-image">
                  <h3 class="modal-title font-weight-bold mb-2">{{ plant.name }}</h3>
                  <p class="mb-1 text-muted"><span class="mr-1">📅</span> <strong>Date:</strong> {{ plant.time }}</p>
                  <p class="text-muted"><span class="mr-1">📍</span> <strong>Location:</strong> {{ plant.place }}</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      {% endfor %}
    </div>

    <!-- Active Production Target Grid Container -->
    <div class="container publications" id="plant-gallery-root"></div>
  </article>
</div>

<script>
function convertToTimestamp(timeStr) {
  if (!timeStr) return "0000-00";
  const months = { Jan: '01', Feb: '02', Mar: '03', Apr: '04', May: '05', June: '06', July: '07', Aug: '08', Sept: '09', Oct: '10', Nov: '11', Dec: '12' };
  const parts = timeStr.trim().split(/\s+/);
  return `${parts[1] || "0000"}-${months[parts[0]] || "01"}`;
}

// Global variable to keep track of currently active filtered items
let visibleItemsList = [];

document.addEventListener("DOMContentLoaded", () => {
  const pool = document.getElementById('raw-plant-pool');
  const root = document.getElementById('plant-gallery-root');
  const items = Array.from(pool.getElementsByClassName('plant-wrapper-group'));

  items.sort((a, b) => convertToTimestamp(b.dataset.time).localeCompare(convertToTimestamp(a.dataset.time)));

  const uniqueYears = [...new Set(items.map(item => item.dataset.time.trim().split(/\s+/)[1]))]
    .filter(Boolean)
    .sort((a, b) => b - a);

  uniqueYears.forEach(year => {
    const section = document.createElement('div');
    section.className = 'year-section mb-5';
    section.dataset.year = year;

    const heading = document.createElement('h2');
    heading.className = 'year-heading bibliography';
    heading.textContent = year;

    const row = document.createElement('div');
    row.className = 'row justify-content-start align-items-center';

    section.appendChild(heading);
    section.appendChild(row);
    root.appendChild(section);

    items.forEach(item => {
      if (item.dataset.time.trim().split(/\s+/)[1] === year) {
        row.appendChild(item);
      }
    });
  });

  // Setup click listeners for arrows using global index mapping
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.custom-nav-btn');
    if (!btn) return;

    const currentWrapper = btn.closest('.plant-wrapper-group');
    const currentIndex = visibleItemsList.indexOf(currentWrapper);
    if (currentIndex === -1) return;

    let targetIndex;
    if (btn.classList.contains('prev-arrow')) {
      targetIndex = currentIndex === 0 ? visibleItemsList.length - 1 : currentIndex - 1;
    } else {
      targetIndex = currentIndex === visibleItemsList.length - 1 ? 0 : currentIndex + 1;
    }

    const targetWrapper = visibleItemsList[targetIndex];
    const targetModalId = `#plantModal-${targetWrapper.dataset.id}`;
    
    // Wait for the current modal hide animation before opening the next one
    setTimeout(() => {
      $(targetModalId).modal('show');
    }, 200); 
  });

  filterPlants('all');
});

function filterPlants(category) {
  const sections = document.querySelectorAll('.year-section');
  visibleItemsList = []; // Reset global list

  sections.forEach(section => {
    const items = section.querySelectorAll('.plant-wrapper-group');
    let hasVisibleItems = false;

    items.forEach(item => {
      if (category === 'all' || item.dataset.category === category) {
        item.style.setProperty('display', '', 'important'); 
        hasVisibleItems = true;
        visibleItemsList.push(item);
      } else {
        item.style.setProperty('display', 'none', 'important');
      }
    });
    section.style.display = hasVisibleItems ? '' : 'none';
  });
}
</script>

<!-- Layout CSS Styling -->
<style>
  /* Significantly enlarged outer static frame */
  .plant-mount-container {
    position: relative;
    width: 200px;  
    height: 200px;
    margin: 0 auto;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    justify-content: center;
    align-items: baseline;
    transition: none; /* Explicitly prevents frame from scaling */
  }
  
  /* Compact photo frame sitting inside the spacious mount space */
  .plant-circle-frame {
    position: relative;
    width: 145px; 
    height: 145px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: var(--global-box-shadow, 0 2px 6px rgba(0,0,0,0.15));
  }
  
  .plant-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease-in-out;
  }
  
  .plant-hover-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  
  .hover-text {
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: bold;
  }
  
  /* Hover effects isolated strictly to the inside contents */
  .plant-card:hover .plant-img {
    transform: scale(1.1);
  }
  .plant-card:hover .plant-hover-overlay {
    opacity: 1;
  }

  .modal {
    position: fixed !important;
    top: 0 !important;
    /* Shifts layout to the true screen center line */
    left: 50% !important;
    transform: translateX(-50%) !important;
    z-index: 1050; 
    width: 100% !important;
    /* Restricts box expanding past content on wide screens */
    max-width: 500px !important; 
    height: 100% !important;
    overflow: hidden !important;
    display: none; /* Keeps default state hidden until triggered by JS */
  }
  
  /* Modal formatting styles */
  .max-modal-image {
    max-height: 55vh;
    object-fit: contain;
    width: 100%;
  }
  .bg-card-color {
    background-color: var(--global-bg-color);
  }
  .text-base-color {
    color: var(--global-text-color);
  }
  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    font-size: 2.5rem;
    color: var(--global-text-color);
    opacity: 0.6;
    transition: opacity 0.2s;
    cursor: pointer;
    z-index: 1050;
    padding: 0 15px;
  }
  .nav-arrow:hover {
    opacity: 1;
  }
  .prev-arrow { left: 0; }
  .next-arrow { right: 0; }
</style>


