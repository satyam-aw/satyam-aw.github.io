---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    <!-- Minimalist Text Filter Controls -->
    <div class="container text-center my-4">
      <div class="d-flex justify-content-center align-items-center flex-wrap" id="plant-filter-text-row">
        <button type="button" class="btn filter-text-btn active" onclick="filterPlants('all', this)">All Species</button>
        <button type="button" class="btn filter-text-btn" onclick="filterPlants('Trees', this)">Trees</button>
        <button type="button" class="btn filter-text-btn" onclick="filterPlants('Shrubs & Woody Vines', this)">Shrubs & Vines</button>
        <button type="button" class="btn filter-text-btn" onclick="filterPlants('Herbaceous Plants & Wildflowers', this)">Herbaceous & Wildflowers</button>
        <button type="button" class="btn filter-text-btn" onclick="filterPlants('Fungi & Marine Organisms', this)">Fungi & Marine</button>
      </div>
    </div>

    <!-- Active Production Target Grid Container -->
    <div class="container" id="plant-gallery-root">
      
      {% assign plants_by_year = site.data.plants | group_by_exp: "item", "item.time | split: ' ' | last" | sort: "name" | reverse %}

      {% for group in plants_by_year %}
        <div class="year-section mb-5" data-year="{{ group.name }}">
          <h2 class="year-heading year">{{ group.name }}</h2>
          <div class="row justify-content-start align-items-center">
            
            {% for plant in group.items %}
              <div class="col-6 col-md-4 col-lg-3 text-center mb-4 plant-wrapper-group" 
                   data-time="{{ plant.time }}" 
                   data-category="{{ plant.category }}"
                   data-id="{{ forloop.parentloop.index }}-{{ forloop.index }}">
                
                <!-- CRITICAL ENHANCEMENT: Removed Bootstrap data-attributes to prevent rendering lockups.
                     Click events are dynamically managed on a per-item basis. -->
                <div class="plant-card" onclick="openIndividualModal('{{ forloop.parentloop.index }}-{{ forloop.index }}')">
                  <div class="plant-mount-container" style="background-image: url('{{ '/assets/img/plants/frame_i.png' | relative_url }}');">
                    <div class="plant-circle-frame" id="frame-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                      
                      <!-- Progressive tracking forces immediate render pipeline processing -->
                      <img 
                        src="{{ plant.image | relative_url }}" 
                        alt="{{ plant.name }}" 
                        class="plant-img img-fluid"
                        loading="lazy"
                        decoding="async"
                        onload="markFirstPassActive('{{ forloop.parentloop.index }}-{{ forloop.index }}')"
                      >
                      
                      <div class="image-spinner-wrapper">
                        <div class="spinner-border spinner-border-sm text-secondary" role="status">
                          <span class="sr-only">Loading...</span>
                        </div>
                      </div>

                      <div class="plant-hover-overlay">
                        <span class="hover-text">🔎 View</span>
                      </div>
                    </div>
                  </div>
                  <p class="title">{{ plant.name }}</p>
                </div>

                <!-- Modal Window Overlay Layout -->
                <div class="modal fade plant-modal-element" id="plantModal-{{ forloop.parentloop.index }}-{{ forloop.index }}" tabindex="-1" role="dialog" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content bg-card-color text-base-color border-0 shadow position-relative">
                      <button type="button" class="nav-arrow prev-arrow custom-nav-btn" data-dismiss="modal">‹</button>
                      <button type="button" class="nav-arrow next-arrow custom-nav-btn" data-dismiss="modal">›</button>
                      
                      <div class="modal-header border-0 pb-0 justify-content-end">
                        <button type="button" class="close text-base-color" data-dismiss="modal" aria-label="Close">
                          <span aria-hidden="true">&times;</span>
                        </button>
                      </div>
                      <div class="modal-body text-center pt-0 px-5">
                        <img src="{{ plant.image | relative_url }}" alt="{{ plant.name }}" class="img-fluid rounded mb-3 max-modal-image">
                        <h3 class="modal-title font-weight-bold mb-2">{{ plant.name }}</h3>
                        <p class="mb-1 text-muted"><span class="mr-1">📅</span> <strong>Date:</strong> {{ plant.time }}</p>
                        <p class="text-muted"><span class="mr-1">📍</span> <strong>Location:</strong> {{ plant.place }}</p>
                      </div>
                    </div>
                  </div>
                </div>

              </div>
            {% endfor %}

          </div>
        </div>
      {% endfor %}

    </div>
  </article>
  
  <div id="zen-snail" style="
  position: absolute; 
  left: 50%;
  top: 50%;
  width: 80px; 
  height: auto;
  pointer-events: none;
  z-index: 9999;
  transform: translate(-50%, -50%);
  transition: transform 0.1s linear;
  will-change: left, top;
">
  <img src="{{ 'assets/img/plants/Stinky_The_Snail.webp' | relative_url }}" alt="Snail" style="width: 100%; height: auto; display: block;">
</div>

</div>

<script>
  const snail = document.getElementById('zen-snail');
  
  // Track target page position
  let targetX = window.innerWidth / 2;
  let targetY = window.innerHeight / 2;
  
  let currentX = targetX;
  let currentY = targetY;
  
  const speed = 0.002; 

  window.addEventListener('mousemove', (e) => {
    targetX = e.pageX;
    targetY = e.pageY;
  });

  function animate() {
    const dx = targetX - currentX;
    const dy = targetY - currentY;
    
    currentX += dx * speed;
    currentY += dy * speed;
    
    snail.style.left = `${currentX}px`;
    snail.style.top = `${currentY}px`;
    
    if (dx > 1) {
      snail.style.transform = 'translate(-50%, -50%) scaleX(-1)';
    } else if (dx < -1) {
      snail.style.transform = 'translate(-50%, -50%) scaleX(1)';
    }
    
    requestAnimationFrame(animate);
  }
  
  animate();

// Dynamic map to instantly track if a card's baseline data layout has rendered its 1st pass
const functionalImagesMap = {};

function markFirstPassActive(uid) {
  const frame = document.getElementById(`frame-${uid}`);
  if (frame) {
    frame.classList.add('first-pass-ready');
    frame.closest('.plant-card').classList.add('first-pass-ready');
  }
  // Store true state instantly for independent clickability
  functionalImagesMap[uid] = true;
}

// Global click handler isolates action requests instantly on an individual basis
function openIndividualModal(uid) {
  // Enables immediate fallback navigation if the item is interacted with
  const targetModalId = `#plantModal-${uid}`;
  $(targetModalId).modal('show');
}

let visibleItemsList = [];

function buildVisibleTrackList() {
  visibleItemsList = Array.from(document.querySelectorAll('.plant-wrapper-group'))
    .filter(item => item.style.display !== 'none');
}

document.addEventListener("DOMContentLoaded", () => {
  buildVisibleTrackList();

  // Unified global tracking loop for arrow keys 
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.custom-nav-btn');
    if (!btn) return;

    const currentWrapper = btn.closest('.plant-wrapper-group');
    const currentIndex = visibleItemsList.indexOf(currentWrapper);
    if (currentIndex === -1) return;

    let targetIndex;
    if (btn.classList.contains('prev-arrow')) {
      targetIndex = currentIndex === 0 ? visibleItemsList.length - 1 : currentIndex - 1;
    } else {
      targetIndex = currentIndex === visibleItemsList.length - 1 ? 0 : currentIndex + 1;
    }

    const targetWrapper = visibleItemsList[targetIndex];
    const targetModalId = `#plantModal-${targetWrapper.dataset.id}`;
    
    setTimeout(() => {
      $(targetModalId).modal('show');
    }, 200); 
  });
});

function filterPlants(category, clickedButton) {
  const sections = document.querySelectorAll('.year-section');

  if (clickedButton) {
    const textButtons = clickedButton.parentElement.querySelectorAll('.filter-text-btn');
    textButtons.forEach(btn => {
      if (btn === clickedButton) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
  }

  sections.forEach(section => {
    const items = section.querySelectorAll('.plant-wrapper-group');
    let hasVisibleItems = false;

    items.forEach(item => {
      if (category === 'all' || item.dataset.category === category) {
        item.style.setProperty('display', '', 'important'); 
        hasVisibleItems = true;
      } else {
        item.style.setProperty('display', 'none', 'important');
      }
    });
    section.style.display = hasVisibleItems ? '' : 'none';
  });

  buildVisibleTrackList();
}
</script>


<!-- Layout CSS Styling -->
<style>
  .filter-text-btn {
    background: transparent !important;
    border: none !important;
    color: var(--global-text-color, #212529) !important;
    margin: 0 14px;
    padding: 6px 4px;
    font-size: 0.95rem;
    /* Inactive style: Normal weight and slightly faded */
    font-weight: 400;
    opacity: 0.6; 
    transition: all 0.2s ease-in-out;
    box-shadow: none !important;
    outline: none !important;
  }

  /* Completely kill Bootstrap's native button focus/click background box */
  .filter-text-btn:focus,
  .filter-text-btn:active,
  .filter-text-btn.focus,
  .filter-text-btn:focus-visible {
    box-shadow: none !important;
    outline: none !important;
    background: transparent !important;
    background-color: transparent !important;
  }

  /* Hover effect: slightly sharpen the text */
  .filter-text-btn:hover {
    opacity: 0.9;
    background: transparent !important;
    text-decoration: none;
  }

  /* Active Filter Selection: Pure bold text and full opacity */
  .filter-text-btn.active {
    font-weight: 700 !important; /* Bold font weight */
    opacity: 1 !important;        /* Crisp, full opacity text */
    background: transparent !important;
    box-shadow: none !important;
    /* Underline effect */
    border-bottom: 2px solid var(--global-theme-color) !important; 
    padding-bottom: 4px !important;    /* Spacing between the text and the underline */
    border-radius: 0 !important;       /* Prevents default Bootstrap button corner clipping */

  }

  /* Significantly enlarged outer static frame */
  .plant-mount-container {
    position: relative;
    width: 200px;  
    height: 200px;
    margin: 0 auto;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    justify-content: center;
    align-items: baseline;
    transition: none; /* Explicitly prevents frame from scaling */
  }

 .plant-circle-frame {
    position: relative;
    overflow: hidden;
    background-color: #e0e0e0;
  }
  
  /* Individual card configuration allows immediate action */
  .plant-card {
    cursor: pointer;
    opacity: 0.85; 
    transition: opacity 0.2s ease;
  }
  
  /* Fallback visibility overrides default hidden rendering behaviors */
  .plant-img {
    display: block !important;
    opacity: 1 !important; 
  }

  .image-spinner-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 2;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  
  /* The instant pass class drops layout locks */
  .first-pass-ready .image-spinner-wrapper {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .first-pass-ready {
    opacity: 1 !important;
  }

  /* Compact photo frame sitting inside the spacious mount space */
  .plant-circle-frame {
    position: relative;
    width: 145px; 
    height: 145px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: var(--global-box-shadow, 0 2px 6px rgba(0,0,0,0.15));
  }
  
  .plant-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease-in-out;
  }
  
  .plant-hover-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  
  .hover-text {
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: bold;
  }
  
  /* Hover effects isolated strictly to the inside contents */
  .plant-card:hover .plant-img {
    transform: scale(1.1);
  }
  .plant-card:hover .plant-hover-overlay {
    opacity: 1;
  }

  .modal {
    position: fixed !important;
    top: 0 !important;
    /* Shifts layout to the true screen center line */
    left: 50% !important;
    transform: translateX(-50%) !important;
    z-index: 1050; 
    width: 100% !important;
    /* Restricts box expanding past content on wide screens */
    max-width: 500px !important; 
    height: 100% !important;
    overflow: hidden !important;
    display: none; /* Keeps default state hidden until triggered by JS */
  }
  
  /* Modal formatting styles */
  .max-modal-image {
    max-height: 55vh;
    object-fit: contain;
    width: 100%;
  }
  .bg-card-color {
    background-color: var(--global-bg-color);
  }
  .text-base-color {
    color: var(--global-text-color);
  }
  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    font-size: 2.5rem;
    color: var(--global-text-color);
    opacity: 0.6;
    transition: opacity 0.2s;
    cursor: pointer;
    z-index: 1050;
    padding: 0 15px;
  }
  .nav-arrow:hover {
    opacity: 1;
  }
  .prev-arrow { left: 0; }
  .next-arrow { right: 0; }
</style>


