---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
<h1 class="post-title" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">    
    <span>{{ page.title }}</span>
    
    <!-- Icon Container forces all children to stay on one row -->
    <span style="display: flex; flex-direction: row-reverse; align-items: center; white-space: nowrap; flex-shrink: 0;">
        {% if page.github %}
          <a
            {% if page.github contains '://' %}
              href="{{ page.github }}"
            {% else %}
              href="{{ page.github | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            class="ms-2"
            title="Code Repository"
          >
            <i class="fa-brands fa-github gh-icon"></i>
          </a>
        {% endif %} 

        {% if page.project_pdf %}
          <a
            {% if page.project_pdf contains '://' %}
              href="{{ page.project_pdf }}"
            {% else %}
              href="{{ page.project_pdf | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            class="ms-2"
            title="PDF Document"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}

        {% if page.demo_video %}
          <a
            {% if page.demo_video contains '://' %}
              href="{{ page.demo_video }}"
            {% else %}
              href="{{ page.demo_video | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            class="ms-2"
            title="Demo Video"
          >
            <i class="fa-solid fa-video"></i>
          </a>
        {% endif %}

        {% if page.download_link %}
          <a
            {% if page.download_link contains '://' %}
              href="{{ page.download_link }}"
            {% else %}
              href="{{ page.download_link | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            class="ms-2"
            title="Download Executable"
          >
            <i class="fa-solid fa-download"></i>
          </a>
        {% endif %}
    </span>
</h1>
<p class="post-description mb-0">{{ page.description }}</p>
{% if page.completed_on %}
  <p class="project-completed text-muted small text-right mb-3">Completed: {{ page.completed_on }}</p>
{% else %}
  <br>
{% endif %}

  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
