---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description mb-0">{{ page.description }}</p>
    {% if page.github or page.project_pdf or page.demo_video or page.download_link or page.completed_on %}
      <div class="project-header-meta">
        <div class="project-header-links" aria-label="Project resources">
          {% if page.github %}
            <a
              {% if page.github contains '://' %}
                href="{{ page.github }}"
              {% else %}
                href="{{ page.github | relative_url }}"
              {% endif %}
              target="_blank"
              rel="noopener noreferrer"
              title="Code Repository"
              aria-label="Code Repository"
            >
              <i class="fa-brands fa-github gh-icon"></i>
            </a>
          {% endif %}

          {% if page.project_pdf %}
            <a
              {% if page.project_pdf contains '://' %}
                href="{{ page.project_pdf }}"
              {% else %}
                href="{{ page.project_pdf | relative_url }}"
              {% endif %}
              target="_blank"
              rel="noopener noreferrer"
              title="PDF Document"
              aria-label="PDF Document"
            >
              <i class="fa-solid fa-file-pdf"></i>
            </a>
          {% endif %}

          {% if page.demo_video %}
            <a
              {% if page.demo_video contains '://' %}
                href="{{ page.demo_video }}"
              {% else %}
                href="{{ page.demo_video | relative_url }}"
              {% endif %}
              target="_blank"
              rel="noopener noreferrer"
              title="Demo Video"
              aria-label="Demo Video"
            >
              <i class="fa-solid fa-video"></i>
            </a>
          {% endif %}

          {% if page.download_link %}
            <a
              {% if page.download_link contains '://' %}
                href="{{ page.download_link }}"
              {% else %}
                href="{{ page.download_link | relative_url }}"
              {% endif %}
              target="_blank"
              rel="noopener noreferrer"
              title="Download Executable"
              aria-label="Download Executable"
            >
              <i class="fa-solid fa-download"></i>
            </a>
          {% endif %}
        </div>
        {% if page.completed_on %}
          <p class="project-completed text-muted small">Period: {{ page.completed_on }}</p>
        {% endif %}
      </div>
    {% endif %}
  </header>

  <article>
    {% if page.research_connection %}
      {% assign project_intro = content | split: '<hr' | first %}
      {% assign project_details = content | remove_first: project_intro %}
      <div class="project-introduction">
        <div class="project-introduction-content">
          {{ project_intro }}
        </div>
        {% include research_connection.liquid %}
      </div>
      {{ project_details }}
    {% else %}
      {{ content }}
    {% endif %}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
