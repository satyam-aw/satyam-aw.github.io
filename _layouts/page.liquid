---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign has_project_sidebar = false %}
{% if page.github
  or page.project_pdf
  or page.demo_video
  or page.download_link
  or page.research_connection
  or page.project_resources
  or page.project_publications
  or page.project_keywords
  or page.project_tools
  or page.project_toc
%}
  {% assign has_project_sidebar = true %}
{% endif %}
<div class="post{% if has_project_sidebar %} post-with-sidebar{% endif %}">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description mb-0">{{ page.description }}</p>
    {% if page.completed_on %}
      <div class="project-header-meta">
        {% if page.completed_on %}
          <p class="project-completed text-muted small">Period: {{ page.completed_on }}</p>
        {% endif %}
      </div>
    {% endif %}
  </header>

  {% if has_project_sidebar %}
    <div class="project-content">
      <article class="project-article">
        {{ content }}
      </article>
      <div class="project-sidebar">
        {% include project_sidebar.liquid %}
      </div>
    </div>
  {% else %}
    <article>
      {{ content }}
    </article>
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
